generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BrandBible {
  id                  String   @id @default(cuid())
  brandName           String
  tagline             String
  originStory         String
  mission             String
  vision              String
  personality         String
  audience            String
  voice               String
  visual              String
  contentPillars      String
  competitors         String
  redLines            String
  offLimitPhrases     String
  lovedPhrases        String
  slogans             String
  inspirationAccounts String
  avoidAccounts       String
  topics              String
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
}

model Post {
  id               String        @id @default(cuid())
  platform         String
  status           String
  contentType      String
  caption          String
  hashtags         String
  audioTrack       String?
  hook             String?
  pillar           String
  thumbnailUrl     String?
  videoUrl         String?
  mediaUrls        String?
  scheduledAt      DateTime?
  publishedAt      DateTime?
  platformPostId   String?
  approvalStatus   String
  approvalNotes    String?
  aiReasoning      String?
  predictedScore   Float?
  flaggedForReview Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  permalink        String?
  metrics          PostMetrics[]
}

model PostMetrics {
  id              String   @id @default(cuid())
  postId          String
  checkpointHours Int
  views           Int      @default(0)
  likes           Int      @default(0)
  comments        Int      @default(0)
  shares          Int      @default(0)
  saves           Int      @default(0)
  completionRate  Float?
  followerGrowth  Int?
  engagementRate  Float?
  recordedAt      DateTime @default(now())
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, checkpointHours])
}

model TrendingItem {
  id          String   @id @default(cuid())
  platform    String
  itemType    String
  value       String
  category    String?
  saturation  Float    @default(0.5)
  growthRate  Float    @default(0)
  usageCount  Int      @default(0)
  niches      String
  exampleUrls String
  isActive    Boolean  @default(true)
  recordedAt  DateTime @default(now())
  expiresAt   DateTime
}

model CompetitorPost {
  id            String   @id @default(cuid())
  account       String
  platform      String
  url           String   @unique
  hook          String?
  caption       String?
  audioUsed     String?
  views         Int?
  likes         Int?
  shares        Int?
  saves         Int?
  comments      Int?
  lengthSeconds Int?
  format        String?
  textOverlays  String?
  cta           String?
  aspectRatio   String?
  pillars       String
  notes         String?
  recordedAt    DateTime @default(now())
}

model PatternEntry {
  id            String   @id @default(cuid())
  pattern       String
  category      String
  avgViews      Float    @default(0)
  avgLikes      Float    @default(0)
  avgEngagement Float    @default(0)
  sampleSize    Int      @default(0)
  score         Float    @default(0)
  notes         String?
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model StrategyReport {
  id              String   @id @default(cuid())
  weekStarting    DateTime
  totalPosts      Int
  avgViews        Float    @default(0)
  avgEngagement   Float    @default(0)
  topPosts        String
  wins            String
  losses          String
  insights        String
  nextWeekPlan    String
  recommendations String
  createdAt       DateTime @default(now())
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ShopifyOrder {
  id            String    @id @default(cuid())
  shopifyId     String    @unique
  orderNumber   String
  totalPrice    Float
  currency      String    @default("GBP")
  utmSource     String?
  utmMedium     String?
  utmCampaign   String?
  utmContent    String?
  referringSite String?
  landingPage   String?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
}

model ContentSuggestion {
  id              String   @id @default(cuid())
  platform        String
  pillar          String
  hook            String
  captionDraft    String
  hashtags        String
  audioSuggestion String?
  visualNotes     String
  reasoning       String
  predictedScore  Float?
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
}

# ── DATABASE ─────────────────────────────────────────────────
# Use Neon.tech free tier or Render PostgreSQL add-on
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ── TELEGRAM BOT ──────────────────────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy token
# 2. Start a chat with your bot, then visit:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  to find your chat ID
TELEGRAM_BOT_TOKEN="123456:ABC-DEF..."
TELEGRAM_CHAT_ID="your-telegram-chat-id"

# ── TWILIO (SMS / WhatsApp) ───────────────────────────────────
# Create account at twilio.com → Account SID & Auth Token in console
# For WhatsApp sandbox: TWILIO_FROM_NUMBER="whatsapp:+14155238886"
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+44xxxxxxxxxx"

# ── GOOGLE REVIEW ─────────────────────────────────────────────
# Get from Google Business Profile → Share Review Form
GOOGLE_REVIEW_URL="https://g.page/r/your-review-link"

# ── CRON SECURITY ─────────────────────────────────────────────
# Any random string — protects the follow-up cron endpoint
CRON_SECRET="generate-a-random-string"
